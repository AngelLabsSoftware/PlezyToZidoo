<?xml version="1.0" encoding="utf-8"?>
<!-- Whole-row highlight for toggle settings (sofa-readable). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/dash_focus_stroke" />
                    <corners android:radius="10dp" />
                </shape>
            </item>
            <item
                android:bottom="3dp"
                android:left="3dp"
                android:right="3dp"
                android:top="3dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/dash_row_focused" />
                    <corners android:radius="8dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/transparent" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
