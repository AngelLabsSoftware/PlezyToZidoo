<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dash_bg"
    android:orientation="vertical"
    android:paddingStart="28dp"
    android:paddingTop="20dp"
    android:paddingEnd="28dp"
    android:paddingBottom="16dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="16dp">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/app_name"
            android:src="@mipmap/ic_launcher" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/dash_text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_subtitle"
                android:textColor="@color/dash_text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/headerVersion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/versionName"
            android:textColor="@color/dash_text_secondary"
            android:textSize="14sp" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/settingsScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Top row: Playback + Up Next | Screensaver -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <!-- Left column -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <!-- Playback panel -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/dash_panel_bg"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            style="@style/TextAppearance.Plezy.PanelTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/player_settings" />

                        <include
                            android:id="@+id/rowUseZidoo"
                            layout="@layout/dash_toggle_row" />

                        <include
                            android:id="@+id/rowShowTitle"
                            layout="@layout/dash_toggle_row" />

                        <include
                            android:id="@+id/rowSkipIntros"
                            layout="@layout/dash_toggle_row" />

                        <include
                            android:id="@+id/rowSkipCredits"
                            layout="@layout/dash_toggle_row" />

                        <TextView
                            style="@style/TextAppearance.Plezy.Hint"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="@string/skip_behavior_title" />

                        <LinearLayout
                            android:id="@+id/segSkipBehavior"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:orientation="horizontal" />

                        <TextView
                            android:id="@+id/overlayStatus"
                            style="@style/TextAppearance.Plezy.Hint"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:background="@drawable/dash_input_bg"
                            android:clickable="true"
                            android:focusable="true"
                            android:padding="12dp"
                            android:text="@string/overlay_permission_denied" />
                    </LinearLayout>

                    <!-- Up Next panel -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/dash_panel_bg"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            style="@style/TextAppearance.Plezy.PanelTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/up_next_settings" />

                        <TextView
                            style="@style/TextAppearance.Plezy.Hint"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/up_next_countdown_title" />

                        <LinearLayout
                            android:id="@+id/segUpNextCountdown"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:orientation="horizontal" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Right column: Screensaver -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1.15"
                    android:background="@drawable/dash_panel_bg"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/TextAppearance.Plezy.PanelTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/screensaver_settings" />

                    <TextView
                        style="@style/TextAppearance.Plezy.Hint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/screensaver_library_title" />

                    <LinearLayout
                        android:id="@+id/segLibrary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="horizontal" />

                    <include
                        android:id="@+id/rowRecentOnly"
                        layout="@layout/dash_toggle_row" />

                    <include
                        android:id="@+id/rowAllowLowerRes"
                        layout="@layout/dash_toggle_row" />

                    <include
                        android:id="@+id/rowShowLogo"
                        layout="@layout/dash_toggle_row" />

                    <include
                        android:id="@+id/rowTextFallback"
                        layout="@layout/dash_toggle_row" />

                    <include
                        android:id="@+id/rowShowYear"
                        layout="@layout/dash_toggle_row" />

                    <TextView
                        style="@style/TextAppearance.Plezy.Hint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/screensaver_logo_size_title" />

                    <LinearLayout
                        android:id="@+id/segLogoSize"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="horizontal" />

                    <TextView
                        style="@style/TextAppearance.Plezy.Hint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/screensaver_interval_title" />

                    <LinearLayout
                        android:id="@+id/segSlideDuration"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="horizontal" />

                    <TextView
                        style="@style/TextAppearance.Plezy.Hint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/screensaver_crossfade_title" />

                    <LinearLayout
                        android:id="@+id/segCrossfade"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="horizontal" />

                    <TextView
                        style="@style/TextAppearance.Plezy.Hint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/screensaver_anim_speed_title" />

                    <LinearLayout
                        android:id="@+id/segAnimSpeed"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="horizontal" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnPreviewScreensaver"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/btn_tv_focus"
                        android:backgroundTint="@null"
                        android:text="@string/screensaver_preview_title"
                        android:textAllCaps="false"
                        android:textColor="@color/tv_focus_button_text" />

                    <TextView
                        style="@style/TextAppearance.Plezy.Hint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/screensaver_how_to_summary" />
                </LinearLayout>
            </LinearLayout>

            <!-- Bottom row: Plex connection | Path substitutions -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/dash_panel_bg"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/TextAppearance.Plezy.PanelTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/plex_server_settings" />

                    <TextView
                        style="@style/TextAppearance.Plezy.Hint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/plex_server_url_summary" />

                    <TextView
                        style="@style/TextAppearance.Plezy.Hint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/plex_server_url_title" />

                    <EditText
                        android:id="@+id/inputServerUrl"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/dash_input_bg"
                        android:hint="@string/plex_server_url_hint"
                        android:imeOptions="actionNext"
                        android:inputType="textUri"
                        android:padding="12dp"
                        android:singleLine="true"
                        android:textColor="@color/dash_text_primary"
                        android:textColorHint="@color/dash_text_secondary"
                        android:textSize="14sp" />

                    <TextView
                        style="@style/TextAppearance.Plezy.Hint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/plex_token_title" />

                    <EditText
                        android:id="@+id/inputPlexToken"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/dash_input_bg"
                        android:hint="••••••••"
                        android:imeOptions="actionDone"
                        android:inputType="textPassword"
                        android:padding="12dp"
                        android:singleLine="true"
                        android:textColor="@color/dash_text_primary"
                        android:textColorHint="@color/dash_text_secondary"
                        android:textSize="14sp" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnTestConnection"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/btn_tv_focus"
                        android:backgroundTint="@null"
                        android:text="@string/plex_test_connection_title"
                        android:textAllCaps="false"
                        android:textColor="@color/tv_focus_button_text" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/dash_panel_bg"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/TextAppearance.Plezy.PanelTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/substitution_settings" />

                    <TextView
                        style="@style/TextAppearance.Plezy.Hint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/path_sub_hint_summary" />

                    <TextView
                        style="@style/TextAppearance.Plezy.Hint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/path_to_replace" />

                    <EditText
                        android:id="@+id/inputPathReplace"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/dash_input_bg"
                        android:hint="@string/path_to_replace_hint"
                        android:imeOptions="actionNext"
                        android:inputType="text"
                        android:padding="12dp"
                        android:singleLine="true"
                        android:textColor="@color/dash_text_primary"
                        android:textColorHint="@color/dash_text_secondary"
                        android:textSize="14sp" />

                    <TextView
                        style="@style/TextAppearance.Plezy.Hint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/replaced_with" />

                    <EditText
                        android:id="@+id/inputPathWith"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/dash_input_bg"
                        android:hint="@string/replaced_with_hint"
                        android:imeOptions="actionDone"
                        android:inputType="text"
                        android:padding="12dp"
                        android:singleLine="true"
                        android:textColor="@color/dash_text_primary"
                        android:textColorHint="@color/dash_text_secondary"
                        android:textSize="14sp" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnManageRules"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/btn_tv_focus"
                        android:backgroundTint="@null"
                        android:text="@string/substitution_link_more"
                        android:textAllCaps="false"
                        android:textColor="@color/tv_focus_button_text" />
                </LinearLayout>
            </LinearLayout>

            <!-- Diagnostics footer panel -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/dash_panel_bg"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/TextAppearance.Plezy.PanelTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/import_export_settings" />

                    <include
                        android:id="@+id/rowDebug"
                        layout="@layout/dash_toggle_row" />

                    <include
                        android:id="@+id/rowExportPasswords"
                        layout="@layout/dash_toggle_row" />
                </LinearLayout>

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnImport"
                    android:layout_width="120dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/btn_tv_focus"
                    android:backgroundTint="@null"
                    android:text="@string/import_button_title"
                    android:textAllCaps="false"
                    android:textColor="@color/tv_focus_button_text" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnExport"
                    android:layout_width="120dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/btn_tv_focus"
                    android:backgroundTint="@null"
                    android:text="@string/export_button_title"
                    android:textAllCaps="false"
                    android:textColor="@color/tv_focus_button_text" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
