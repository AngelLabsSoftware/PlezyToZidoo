<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <ImageView
        android:id="@+id/backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#B3000000" />

    <!-- Centred composition with comfortable bottom space -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginStart="64dp"
        android:layout_marginEnd="64dp"
        android:layout_marginBottom="72dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:id="@+id/upNextLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.15"
            android:text="@string/up_next_label"
            android:textAllCaps="true"
            android:textColor="#80FFFFFF"
            android:textSize="16sp" />

        <ImageView
            android:id="@+id/episodeThumbnail"
            android:layout_width="480dp"
            android:layout_height="270dp"
            android:layout_marginTop="20dp"
            android:adjustViewBounds="true"
            android:background="@drawable/thumbnail_border"
            android:contentDescription="@string/up_next_label"
            android:scaleType="centerCrop" />

        <TextView
            android:id="@+id/seriesName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/episodeInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="#B3FFFFFF"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/countdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Playing in 10"
            android:textColor="#80FFFFFF"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnPlayNow"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:background="@drawable/btn_tv_focus"
                android:focusable="true"
                android:minWidth="168dp"
                android:nextFocusRight="@id/btnCancel"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:text="@string/play_now"
                android:textAllCaps="false"
                android:textColor="@color/tv_focus_button_text"
                android:textSize="16sp" />

            <Button
                android:id="@+id/btnCancel"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="16dp"
                android:background="@drawable/btn_tv_focus"
                android:focusable="true"
                android:minWidth="128dp"
                android:nextFocusLeft="@id/btnPlayNow"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:text="@string/cancel"
                android:textAllCaps="false"
                android:textColor="@color/tv_focus_button_text"
                android:textSize="16sp" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
