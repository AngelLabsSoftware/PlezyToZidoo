<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/ruleTitle"
        style="@style/TextAppearance.Plezy.PanelTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:baselineAligned="false"
        android:clipChildren="false"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:clipChildren="false"
            android:orientation="vertical">

            <TextView
                style="@style/TextAppearance.Plezy.Hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/path_to_replace" />

            <EditText
                android:id="@+id/rulePathReplace"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/dash_input_bg"
                android:hint="@string/path_to_replace_hint"
                android:imeOptions="actionNext"
                android:inputType="text"
                android:padding="12dp"
                android:singleLine="true"
                android:textColor="@color/dash_text_primary"
                android:textColorHint="@color/dash_text_secondary"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:clipChildren="false"
            android:orientation="vertical">

            <TextView
                style="@style/TextAppearance.Plezy.Hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/replaced_with" />

            <EditText
                android:id="@+id/rulePathWith"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/dash_input_bg"
                android:hint="@string/replaced_with_hint"
                android:imeOptions="actionNext"
                android:inputType="text"
                android:padding="12dp"
                android:singleLine="true"
                android:textColor="@color/dash_text_primary"
                android:textColorHint="@color/dash_text_secondary"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:baselineAligned="false"
        android:clipChildren="false"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:clipChildren="false"
            android:orientation="vertical">

            <TextView
                style="@style/TextAppearance.Plezy.Hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/smbUsername_title" />

            <EditText
                android:id="@+id/ruleSmbUser"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/dash_input_bg"
                android:imeOptions="actionNext"
                android:inputType="text"
                android:padding="12dp"
                android:singleLine="true"
                android:textColor="@color/dash_text_primary"
                android:textColorHint="@color/dash_text_secondary"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:clipChildren="false"
            android:orientation="vertical">

            <TextView
                style="@style/TextAppearance.Plezy.Hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/smbPassword_title" />

            <EditText
                android:id="@+id/ruleSmbPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/dash_input_bg"
                android:hint="••••••••"
                android:imeOptions="actionDone"
                android:inputType="textPassword"
                android:padding="12dp"
                android:singleLine="true"
                android:textColor="@color/dash_text_primary"
                android:textColorHint="@color/dash_text_secondary"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
