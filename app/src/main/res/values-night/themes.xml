<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Night mirrors day — dashboard is always charcoal -->
    <style name="Theme.PlezyPlexToZidoo" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/white</item>
        <item name="colorPrimaryVariant">@color/dash_panel</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorSecondary">@color/dash_text_secondary</item>
        <item name="colorSecondaryVariant">@color/dash_text_secondary</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="colorAccent">@color/white</item>
        <item name="android:statusBarColor">@color/dash_bg</item>
        <item name="android:windowBackground">@color/dash_bg</item>
        <item name="android:textColorPrimary">@color/dash_text_primary</item>
        <item name="android:textColorSecondary">@color/dash_text_secondary</item>
        <item name="materialButtonStyle">@style/Widget.Plezy.MonoButton</item>
        <item name="buttonStyle">@style/Widget.Plezy.MonoButton</item>
        <item name="switchStyle">@style/Widget.Plezy.MonoSwitch</item>
        <item name="android:colorControlActivated">@color/white</item>
    </style>

    <style name="Theme.PlezyPlexToZidoo.Settings" parent="Theme.PlezyPlexToZidoo">
        <item name="android:windowBackground">@color/dash_bg</item>
    </style>

    <style name="Theme.PlezyPlexToZidoo.Play" parent="Theme.PlezyPlexToZidoo">
        <item name="android:windowBackground">@color/black</item>
    </style>
</resources>
