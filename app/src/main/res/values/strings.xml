    <!-- Screensaver / DayDream -->
    <string name="screensaver_settings">Plex screensaver</string>
    <string name="screensaver_label">Plex Artwork</string>
    <string name="screensaver_how_to_title">Enable on Zidoo</string>
    <string name="screensaver_how_to_summary">Open the Zidoo’s Android screensaver settings and select “Plex Artwork”. Do not use Image Player “set as screensaver”. Home Theater modes may override — exit HT if needed. Separate from Skip overlay permission.</string>
    <string name="screensaver_library_title">Library content</string>
    <string name="screensaver_recent_title">Recent titles only</string>
    <string name="screensaver_recent_summary">Only titles originally released in the last two years</string>
    <string name="screensaver_interval_title">Slide duration</string>
    <string name="screensaver_interval_summary">How long each artwork stays on screen</string>
    <string name="screensaver_crossfade_title">Crossfade duration</string>
    <string name="screensaver_anim_speed_title">Animation speed</string>
    <string name="screensaver_anim_speed_summary">Ken Burns / motion speed. 1x is the current default pace.</string>
    <string name="screensaver_allow_lower_res_title">Allow lower-res artwork</string>
    <string name="screensaver_allow_lower_res_summary">Off by default. When off, only genuine 4K (or larger) fanart is shown.</string>
    <string name="screensaver_show_logo_title">Show transparent logos</string>
    <string name="screensaver_show_logo_summary">Uses Plex clearLogo when available. By default only titles with a usable logo are shown.</string>
    <string name="screensaver_allow_text_title_title">Allow text title fallback</string>
    <string name="screensaver_allow_text_title_summary">Off by default. When on, titles without a clearLogo may show as understated white text.</string>
    <string name="screensaver_logo_size_title">Logo size</string>
    <string name="screensaver_logo_size_summary" formatted="false">Small 25% left, Medium 50% left (default), Large 80% centred — never upscaled past native</string>
    <string name="screensaver_show_date_title">Show release year</string>
    <string name="screensaver_show_date_summary">From Plex originallyAvailableAt / year</string>
    <string name="screensaver_preview_title">Preview screensaver</string>
    <string name="screensaver_preview_summary">Runs the same renderer as DayDream (Back or tap to exit)</string>
    <string name="screensaver_art_desc">Plex background artwork</string>
    <string name="screensaver_logo_desc">Plex clear logo</string>
    <string name="screensaver_title_desc">Title text fallback</string>
