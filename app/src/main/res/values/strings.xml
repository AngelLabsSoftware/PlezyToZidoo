    <string name="smbPassword_title">SMB password (optional)</string>
    <string name="substitution_link">Add additional substitutions</string>
    <string name="substitution_rule_2_title">Path Substitution Rule 2 (optional)</string>
    <string name="substitution_link_more">Manage additional rules</string>
    <string name="manage_rules_title">Additional path rules</string>
    <string name="manage_rules_subtitle">Rules 2–10 · values edit in place · passwords masked</string>
    <string name="rule_card_title">Rule %1$d</string>

    <!-- Import/Export -->
    <string name="import_export_description">Backup file: Downloads/PlezyPlexToZidooSettings.txt. Tokens and SMB passwords are omitted unless Include passwords is on.</string>
    <string name="export_include_passwords_title">Include passwords in export</string>
    <string name="export_include_passwords_summary">Writes the Plex token and SMB passwords into the export file in plain text. Keep that file secure.</string>
    <string name="import_button_title">Import</string>
    <string name="export_button_title">Export</string>

