    <!-- Player Preferences -->
    <string name="useZidooPlayer_title">Use Zidoo native player</string>
    <string name="showTitle_title">Show title on playback</string>
    <string name="skip_intros_title">Skip intros</string>
    <string name="skip_credits_title">Skip credits</string>
    <string name="skip_behavior_title">Skip behaviour</string>
    <string name="skip_behavior_summary">Manual button (default), countdown, or instant auto-skip</string>
    <string name="overlay_permission_title">Allow Skip overlay</string>
    <string name="overlay_permission_summary">Required for Manual and Countdown skip over the Zidoo player. On first play after install, an Android settings side panel may appear — scroll the app list to PlezyPlexToZidoo and allow display over other apps. Separate from screensaver settings.</string>
    <string name="overlay_permission_toast">On first play: Android settings side panel → scroll app list → PlezyPlexToZidoo → allow display over other apps (not the screensaver setting).</string>
    <string name="overlay_permission_granted">Overlay permission · Granted</string>
    <string name="overlay_permission_denied">Overlay permission · Not granted — tap to open</string>
    <string name="path_sub_hint_title">Path tip</string>
    <string name="path_sub_hint_summary">Example: if Plex reports /media/… and the Zidoo sees /data/…, use /media/ → /data/. Your paths depend on how Plex and the Zidoo mount storage.</string>

    <!-- Plex Preferences -->
    <string name="plex_server_settings">Plex connection</string>
    <string name="plex_server_url_title">Server URL</string>
    <string name="plex_server_url_summary">Required for the screensaver. Optional fallback for Plezy playback if the URI omits server details. Example: http://192.168.1.10:32400</string>
    <string name="plex_server_url_hint">http://192.168.1.10:32400</string>
    <string name="plex_server_url_port_title">Add Plex port 32400?</string>
    <string name="plex_server_url_port_message">This looks like a LAN address without a port. Plex Media Server usually listens on 32400.\n\nUse %1$s?</string>
    <string name="plex_server_url_port_yes">Use :32400</string>
    <string name="plex_server_url_port_no">Keep as entered</string>
    <string name="plex_token_title">Plex token</string>
    <string name="plex_token_summary">Required for the screensaver. Optional fallback when Plezy does not supply a token. Stored securely.</string>
    <string name="plex_test_connection_title">Test connection</string>
    <string name="plex_test_connection_summary">Verify Server URL + token against /identity</string>

    <!-- Up Next -->
    <string name="up_next_countdown_title">Autoplay countdown</string>
    <string name="up_next_countdown_summary">How long Up Next waits before starting the next episode. Skip Intro/Credits countdown stays at 3 seconds.</string>
    <string name="up_next_playing_in">Playing in %1$d</string>

    <!-- Substitution Preferences -->
    <string name="substitution_description">Translate the path Plex reports into a path the Zidoo can open. Match a path prefix. Use additional rules for other libraries or SMB credentials.</string>
