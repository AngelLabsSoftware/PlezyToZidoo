<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base: monochrome charcoal — no purple/teal accents in chrome -->
    <style name="Theme.PlezyPlexToZidoo" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/white</item>
        <item name="colorPrimaryVariant">@color/dash_panel</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorSecondary">@color/dash_text_secondary</item>
        <item name="colorSecondaryVariant">@color/dash_text_secondary</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="colorAccent">@color/white</item>
        <item name="android:statusBarColor">@color/dash_bg</item>
        <item name="android:windowBackground">@color/dash_bg</item>
        <item name="android:textColorPrimary">@color/dash_text_primary</item>
        <item name="android:textColorSecondary">@color/dash_text_secondary</item>
        <item name="materialButtonStyle">@style/Widget.Plezy.MonoButton</item>
        <item name="buttonStyle">@style/Widget.Plezy.MonoButton</item>
        <item name="switchStyle">@style/Widget.Plezy.MonoSwitch</item>
        <item name="android:colorControlActivated">@color/white</item>
    </style>

    <style name="Theme.PlezyPlexToZidoo.Settings" parent="Theme.PlezyPlexToZidoo">
        <item name="android:windowBackground">@color/dash_bg</item>
    </style>

    <style name="Theme.PlezyPlexToZidoo.Play" parent="Theme.PlezyPlexToZidoo">
        <item name="android:windowBackground">@color/black</item>
    </style>

    <style name="Theme.PlezyPlexToZidoo.UpNext" parent="Theme.PlezyPlexToZidoo">
        <item name="windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowBackground">@color/black</item>
        <item name="colorPrimary">@color/white</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="materialButtonStyle">@style/Widget.Plezy.MonoButton</item>
        <item name="buttonStyle">@style/Widget.Plezy.MonoButton</item>
    </style>

    <style name="Widget.Plezy.MonoButton" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/btn_tv_focus</item>
        <item name="backgroundTint">@null</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:textColor">@color/tv_focus_button_text</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">44dp</item>
    </style>

    <style name="Widget.Plezy.MonoSwitch" parent="Widget.AppCompat.CompoundButton.Switch">
        <item name="android:thumb">@drawable/switch_thumb_mono</item>
        <item name="track">@drawable/switch_track_mono</item>
        <item name="android:colorControlActivated">@color/white</item>
    </style>

    <style name="TextAppearance.Plezy.PanelTitle" parent="TextAppearance.AppCompat.Medium">
        <item name="android:textColor">@color/dash_text_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="TextAppearance.Plezy.Label" parent="TextAppearance.AppCompat.Small">
        <item name="android:textColor">@color/dash_text_primary</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="TextAppearance.Plezy.Hint" parent="TextAppearance.AppCompat.Small">
        <item name="android:textColor">@color/dash_text_secondary</item>
        <item name="android:textSize">12sp</item>
    </style>
</resources>
