<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_preferences">

    <PreferenceCategory app:title="@string/plex_server_settings">

        <EditTextPreference
            android:defaultValue=""
            android:key="plex_server_url"
            android:title="@string/plex_server_url_title"
            android:summary="@string/plex_server_url_summary"
            app:useSimpleSummaryProvider="false"
            android:singleLine="true" />

        <!-- Not persistent: the value is written to encrypted storage -->
        <EditTextPreference
            android:defaultValue=""
            android:key="plex_token"
            android:persistent="false"
            android:title="@string/plex_token_title"
            android:summary="@string/plex_token_summary"
            app:useSimpleSummaryProvider="false"
            android:singleLine="true"
            android:inputType="textPassword" />

        <Preference
            android:key="plex_test_connection"
            android:title="@string/plex_test_connection_title"
            android:summary="@string/plex_test_connection_summary" />

    </PreferenceCategory>

    <Preference
        android:key="version"
        android:persistent="false"
        android:title="@string/version_settings"
        android:summary="@string/versionName" />

    <PreferenceCategory app:title="@string/general_settings">

        <SwitchPreference
            android:defaultValue="true"
            android:key="debug"
            android:title="@string/debug_title" />

    </PreferenceCategory>

    <PreferenceCategory app:title="@string/player_settings">

        <SwitchPreference
            android:defaultValue="true"
            android:key="useZidooPlayer"
            android:title="@string/useZidooPlayer_title" />

        <SwitchPreference
            android:defaultValue="true"
            android:key="showTitle"
            android:title="@string/showTitle_title"
            android:dependency="useZidooPlayer" />

        <SwitchPreference
            android:defaultValue="true"
            android:key="skip_intros"
            android:title="@string/skip_intros_title"
            android:dependency="useZidooPlayer" />

        <SwitchPreference
            android:defaultValue="true"
            android:key="skip_credits"
            android:title="@string/skip_credits_title"
            android:dependency="useZidooPlayer" />

        <ListPreference
            android:defaultValue="manual"
            android:key="skip_behavior"
            android:title="@string/skip_behavior_title"
            android:summary="@string/skip_behavior_summary"
            android:entries="@array/skip_behavior_entries"
            android:entryValues="@array/skip_behavior_values"
            android:dependency="useZidooPlayer" />

        <Preference
            android:key="overlay_permission"
            android:persistent="false"
            android:title="@string/overlay_permission_title"
            android:summary="@string/overlay_permission_summary"
            android:dependency="useZidooPlayer" />

    </PreferenceCategory>

    <PreferenceCategory app:title="@string/substitution_settings">

        <Preference
            android:key="path_sub_hint"
            android:persistent="false"
            android:title="@string/path_sub_hint_title"
            android:summary="@string/path_sub_hint_summary"
            android:selectable="false" />

        <Preference
            android:key="substitution_description"
            android:persistent="false"
            android:title="@string/substitution_description"
            android:selectable="false" />

        <EditTextPreference
            android:defaultValue=""
            android:key="path_to_replace"
            android:title="@string/path_to_replace"
            app:useSimpleSummaryProvider="true"
            android:singleLine="true" />

        <EditTextPreference
            android:defaultValue=""
            android:key="replaced_with"
            android:title="@string/replaced_with"
            app:useSimpleSummaryProvider="true"
            android:singleLine="true" />

        <EditTextPreference
            android:defaultValue=""
            android:key="smbUsername"
            android:title="@string/smbUsername_title"
            app:useSimpleSummaryProvider="true"
            android:singleLine="true" />

        <EditTextPreference
            android:defaultValue=""
            android:key="smbPassword"
            android:persistent="false"
            android:title="@string/smbPassword_title"
            app:useSimpleSummaryProvider="false"
            android:singleLine="true"
            android:inputType="textPassword" />

    </PreferenceCategory>

    <PreferenceCategory app:title="@string/substitution_rule_2_title">

        <EditTextPreference
            android:defaultValue=""
            android:key="path_to_replace_02"
            android:title="@string/path_to_replace"
            app:useSimpleSummaryProvider="true"
            android:singleLine="true" />

        <EditTextPreference
            android:defaultValue=""
            android:key="replaced_with_02"
            android:title="@string/replaced_with"
            app:useSimpleSummaryProvider="true"
            android:singleLine="true" />

        <EditTextPreference
            android:defaultValue=""
            android:key="smbUsername_02"
            android:title="@string/smbUsername_title"
            app:useSimpleSummaryProvider="true"
            android:singleLine="true" />

        <EditTextPreference
            android:defaultValue=""
            android:key="smbPassword_02"
            android:persistent="false"
            android:title="@string/smbPassword_title"
            app:useSimpleSummaryProvider="false"
            android:singleLine="true"
            android:inputType="textPassword" />

        <Preference
            android:key="substitution_link"
            android:title="@string/substitution_link_more" />

    </PreferenceCategory>

    <PreferenceCategory app:title="@string/screensaver_settings">

        <Preference
            android:key="screensaver_how_to"
            android:persistent="false"
            android:title="@string/screensaver_how_to_title"
            android:summary="@string/screensaver_how_to_summary"
            android:selectable="false" />

        <ListPreference
            android:defaultValue="20"
            android:key="screensaver_interval_sec"
            android:title="@string/screensaver_interval_title"
            android:summary="@string/screensaver_interval_summary"
            android:entries="@array/screensaver_interval_entries"
            android:entryValues="@array/screensaver_interval_values" />

        <SwitchPreference
            android:defaultValue="false"
            android:key="screensaver_allow_lower_res"
            android:title="@string/screensaver_allow_lower_res_title"
            android:summary="@string/screensaver_allow_lower_res_summary" />

        <SwitchPreference
            android:defaultValue="true"
            android:key="screensaver_show_logo"
            android:title="@string/screensaver_show_logo_title"
            android:summary="@string/screensaver_show_logo_summary" />

        <ListPreference
            android:defaultValue="small"
            android:key="screensaver_logo_size"
            android:title="@string/screensaver_logo_size_title"
            android:summary="@string/screensaver_logo_size_summary"
            android:entries="@array/screensaver_logo_size_entries"
            android:entryValues="@array/screensaver_logo_size_values"
            android:dependency="screensaver_show_logo" />

        <SwitchPreference
            android:defaultValue="true"
            android:key="screensaver_show_date"
            android:title="@string/screensaver_show_date_title"
            android:summary="@string/screensaver_show_date_summary" />

        <Preference
            android:key="screensaver_preview"
            android:persistent="false"
            android:title="@string/screensaver_preview_title"
            android:summary="@string/screensaver_preview_summary" />

    </PreferenceCategory>

    <PreferenceCategory app:title="@string/import_export_settings">

        <Preference
            android:key="import_export_description"
            android:persistent="false"
            android:title="@string/import_export_description"
            android:selectable="false" />

        <SwitchPreference
            android:defaultValue="false"
            android:key="export_include_passwords"
            android:title="@string/export_include_passwords_title"
            android:summary="@string/export_include_passwords_summary" />

        <Preference
            android:key="import_export"
            android:persistent="false"
            android:title="Import/Export"
            android:layout="@layout/import_export"
            android:selectable="false" />

    </PreferenceCategory>

</PreferenceScreen>
